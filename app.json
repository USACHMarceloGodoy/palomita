{
  "expo": {
    "name": "Palomita",
    "slug": "palomita",
    "version": "1.0.0",
    "scheme": "palomita",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFE4EC"
    },
    "android": {
      "package": "cl.palomita.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFE4EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFE4EC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6F91"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Palomita usa tu ubicación para desbloquear recuerdos en nuestros lugares.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-updates",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Palomita",
              "label": "Palomita",
              "description": "Días juntos, mensaje del día y la mascota",
              "minWidth": "250dp",
              "minHeight": "80dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/4409e77c-d67e-447f-b445-16f9304babdd",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "4409e77c-d67e-447f-b445-16f9304babdd"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
